# Deny by default; only reusable pipeline source is public.
/*
!/.gitignore
!/README.md
!/CONTRIBUTING.md
!/requirements.txt
!/requirements-optional.txt
!/config.example.json
!/scripts/
/scripts/**
!/scripts/**/
!/scripts/**/*.py
!/scripts/**/*.ps1
!/tests/
/tests/**
!/tests/**/
!/tests/**/*.py
!/tests/**/*.ps1
!/schemas/
/schemas/**
!/schemas/**/
!/schemas/**/*.json
!/examples/
/examples/**
!/examples/**/
!/examples/**/*.py
!/examples/**/*.json
!/examples/**/*.md
!/docs/
/docs/**
!/docs/**/
!/docs/**/*.md
!/.github/
/.github/**
!/.github/**/
!/.github/**/*.yml

# Private/generated content never belongs in Git.
.env
.env.*
config.json
__pycache__/
*.pyc
*.mp4
*.mkv
*.mov
*.wav
*.mp3
*.jpg
*.png
*.sqlite*
