{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Video Edit Pipeline single-timeline workspace v2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 2
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "subtitle": {
      "type": "string"
    },
    "media_root": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\u0000\r\n]+$"
    },
    "timeline": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\u0000\r\n]+$"
    },
    "render": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\u0000\r\n]+$"
        },
        "timeline_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "source",
        "timeline_sha256"
      ]
    }
  },
  "required": [
    "version",
    "title",
    "media_root",
    "timeline"
  ]
}
